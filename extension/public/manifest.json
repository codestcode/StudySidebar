{
  "manifest_version": 3,
  "name": "EduSpark",
  "version": "1.0.0",
  "description": "AI-powered study assistant for CS students",
  "permissions": ["activeTab", "tabs", "scripting", "storage", "declarativeNetRequest", "alarms", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "action": {

    "default_title": "EduSpark",
    "default_icon": {
      "16": "images/eduspark.png",
      "48": "images/eduspark.png",
      "128": "images/eduspark.png"
    }
  },
  "icons": {
    "16": "images/eduspark.png",
    "48": "images/eduspark.png",
    "128": "images/eduspark.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
